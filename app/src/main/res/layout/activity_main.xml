<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F5E5CE"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Menu Główne"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#5A4A42"
        android:layout_marginBottom="48dp" />

    <!-- Kafelek: Gra -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_play"
        android:layout_width="260dp"
        android:layout_height="80dp"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Nakarm Obżartucha"
            android:gravity="center"
            android:textSize="20sp"
            android:background="#A3B18A"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </androidx.cardview.widget.CardView>

    <!-- Kafelek: Kolekcja -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_collection"
        android:layout_width="260dp"
        android:layout_height="80dp"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Kolekcja Akcesoriów"
            android:gravity="center"
            android:textSize="20sp"
            android:background="#DDA15E"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </androidx.cardview.widget.CardView>

    <!-- Kafelek: Wyjście -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_exit"
        android:layout_width="260dp"
        android:layout_height="80dp"
        android:clickable="true"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Wyjście z Gry"
            android:gravity="center"
            android:textSize="20sp"
            android:background="#D08C8C"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </androidx.cardview.widget.CardView>

</LinearLayout>