<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5E5CE"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_round_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Runda 1  |  Potrawy: 0/5"
            android:textColor="#5A4A42"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:id="@+id/btn_menu"
            android:layout_width="130dp"
            android:layout_height="86dp"
            android:layout_alignParentEnd="true"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Menu"
                android:gravity="center"
                android:textSize="16sp"
                android:background="#D08C8C"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </androidx.cardview.widget.CardView>

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zapotrzebowanie"
            android:textSize="44sp"
            android:textStyle="bold"
            android:textColor="#5A4A42" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/tv_protein"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Białko: 0g"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#C86D51" />

            <TextView
                android:id="@+id/tv_kcal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:gravity="center"
                android:text="Kcal: 0"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#B5651D" />

            <TextView
                android:id="@+id/tv_sugar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center"
                android:text="Cukier: 0/25g"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#B8860B" />

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/game_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/iv_obzartuch"
            android:layout_width="400dp"
            android:layout_height="400dp"
            android:layout_gravity="center"
            android:layout_marginBottom="64dp"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/iv_selected_food"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

    </FrameLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/btn_food_list"
            android:layout_width="130dp"
            android:layout_height="86dp"
            android:layout_alignParentStart="true"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Lista potraw"
                android:gravity="center"
                android:textSize="16sp"
                android:background="#84A59D"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btn_next"
            android:layout_width="130dp"
            android:layout_height="86dp"
            android:layout_alignParentEnd="true"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Dalej"
                android:gravity="center"
                android:textSize="16sp"
                android:background="#A3B18A"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </androidx.cardview.widget.CardView>

    </RelativeLayout>

</LinearLayout>